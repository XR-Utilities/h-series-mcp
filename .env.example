# h-series-mcp environment. All vars are optional: the server is a stateless
# passthrough with working defaults. Copy to .env for local overrides. No
# secrets live here; the caller supplies any x402 payment envelope per call.

# Transport selection when not passed on the CLI: "stdio" (default) or "http".
MCP_TRANSPORT=stdio

# HTTP transport listen port. Defaults to 8080. Only read for the http transport.
PORT=8080

# Log threshold for the structured stderr logger: debug | info | warn | error.
# Defaults to info.
LOG_LEVEL=info

# Set to 1 to skip the startup schema-discipline check (the live backend
# config/manifest fetch). Useful when dev networking is flaky. Default: run it.
MCP_SKIP_VALIDATE=0

# Set to 1 to exit non-zero when the startup check finds schema drift against a
# backend. Default: log and continue.
MCP_FAIL_ON_DRIFT=0

# Backend base URL overrides. Each backend defaults to its live production host;
# set these to point the proxy at a staging or local instance. Only H-Seal and
# H-Relay are overridable today; the other six backends use hardcoded prod hosts.
H_SEAL_BACKEND_URL=https://h-seal.xr-utilities.ai
H_RELAY_BACKEND_URL=https://h-relay-production.up.railway.app

# ---- SIEM audit observability (fail-safe OFF) ----
# The dispatcher emits one signed audit event per tool call to the SHARED estate
# audit topic, reindexed + served per-agent at the H-Index hub (/admin/audit-events).
# Events: mcp.tool_call (activity) on a resolved call, mcp.tool_call_failed
# (service_failure on 5xx/network, malicious_suspicious on a non-402 4xx). Public-safe
# scalar fields only: tool, service, route, status, latencyMs, and a PRIVACY-SAFE caller
# IP (salted HMAC ipHash + /24 ipPrefix). The RAW IP is NEVER anchored; it appears only in
# the stderr op-log. When these three vars are unset the sink is log-only (nothing anchors)
# and the Hedera SDK is never loaded, so the passthrough runs unchanged with audit OFF.
# AUDIT_OPERATOR_ID=0.0.xxxxxxx
# AUDIT_OPERATOR_KEY=              # ECDSA secp256k1 raw hex; secret, env-only, never committed
# HCS_AUDIT_TOPIC_ID=0.0.xxxxxxx

# Anchor network for the audit operator: mainnet (default) | testnet.
# HEDERA_NETWORK=mainnet

# Secret salt for the public-plane caller-IP HMAC. Set it for stable cross-restart
# correlation of repeat callers; unset uses a per-process random key (not correlatable
# across restarts). The raw IP is never derivable from the hash regardless.
# AUDIT_IP_HASH_SALT=

# Option (c) agent-activity trace: POST each tool-call to the H-Index hub's queryable,
# non-anchored trace store. Both must be set for tracing (else no-op). ACTIVITY_INGEST_SECRET
# must match the value set on H-Index. The IP is hashed before it leaves this process.
HINDEX_ACTIVITY_URL=https://h-index.xr-utilities.ai/activity
ACTIVITY_INGEST_SECRET=
